rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // =================================
    // Helper Functions
    // =================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isLandlord(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isManager(userId) {
      return isAuthenticated() && request.auth.token.role == 'manager' && request.auth.uid == userId;
    }
    
    function isTenant(userId) {
      return isAuthenticated() && request.auth.token.role == 'tenant' && request.auth.uid == userId;
    }

    function isLandlordOfResource(landlordId) {
      return isLandlord(landlordId);
    }

    function isManagerOfLandlord(landlordId) {
      return isAuthenticated() && request.auth.token.role == 'manager' && request.auth.token.landlordId == landlordId;
    }

    function getManagerPermissions() {
      return get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.permissions;
    }

    function isOwnerOrManager(landlordId) {
      return isLandlordOfResource(landlordId) || isManagerOfLandlord(landlordId);
    }
    
    // =================================
    // Collections
    // =================================
    
    // Landlords: Can only read/update their own profile.
    match /landlords/{landlordId} {
      allow read, update: if isLandlord(landlordId);
    }
    
    // Managers: Landlord can manage them. Managers can read their own profile.
    match /managers/{managerId} {
        allow read: if isOwnerOrManager(resource.data.landlordId);
        allow create, update, delete: if isLandlordOfResource(resource.data.landlordId);
    }
    
    // Properties: Only accessible by the owner landlord or their managers.
    match /properties/{propertyId} {
      allow read: if isOwnerOrManager(resource.data.landlordId);
      allow create: if isOwnerOrManager(request.resource.data.landlordId)
                    && (isLandlordOfResource(request.resource.data.landlordId) || getManagerPermissions().canAddProperties);
      allow update: if isOwnerOrManager(resource.data.landlordId)
                    && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canEditProperties);
      allow delete: if isOwnerOrManager(resource.data.landlordId)
                    && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canDeleteProperties);
                    
      // Units subcollection
      match /units/{unitId} {
        allow read: if isOwnerOrManager(get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId);
        allow create, update, delete: if isOwnerOrManager(get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId);
      }
    }
    
    // Tenants: Landlord/Manager can manage. Tenant can read their own data.
    match /tenants/{tenantId} {
      allow read: if (isOwnerOrManager(resource.data.landlordId) && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canViewTenants)) 
                    || isTenant(tenantId);
      allow create: if isOwnerOrManager(request.resource.data.landlordId)
                    && (isLandlordOfResource(request.resource.data.landlordId) || getManagerPermissions().canAddTenants);
      allow update: if isOwnerOrManager(resource.data.landlordId) 
                    && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canEditTenants);
      allow delete: if isOwnerOrManager(resource.data.landlordId)
                    && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canDeleteTenants);
    }
    
    // Payments: Landlord/Manager can read. Tenant can read their own.
    match /payments/{paymentId} {
      allow read: if (isOwnerOrManager(resource.data.landlordId) && (isLandlordOfResource(resource.data.landlordId) || getManagerPermissions().canViewPayments))
                    || isTenant(resource.data.tenantId);
      allow create: if isOwnerOrManager(request.resource.data.landlordId)
                    && (isLandlordOfResource(request.resource.data.landlordId) || getManagerPermissions().canViewPayments); // Simplified permission
    }
    
    // Maintenance Requests: Landlord/Manager can manage. Tenant can manage their own.
    match /maintenanceRequests/{requestId} {
       allow read, update: if isOwnerOrManager(resource.data.landlordId);
       allow create: if isTenant(request.resource.data.tenantId);
       allow delete: if isOwnerOrManager(resource.data.landlordId) || isTenant(resource.data.tenantId);
    }
    
    // Messages: Landlord/Manager can manage. Tenant can manage their own.
    match /messages/{messageId} {
      allow read, create: if isAuthenticated() && 
                             (isOwnerOrManager(get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.landlordId) ||
                              isTenant(request.resource.data.tenantId));
    }

    // Audit Logs: Only landlord and authorized managers can read. No client writes.
    match /auditLogs/{logId} {
        allow read: if isOwnerOrManager(resource.data.landlordId);
        allow write: if false; // Only server can write audit logs
    }
    
    // Reminders: Landlord/Manager can manage.
    match /reminders/{reminderId} {
      allow read, write, delete: if isOwnerOrManager(resource.data.landlordId);
    }

  }
}