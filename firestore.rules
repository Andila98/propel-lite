rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an authenticated landlord or an authorized manager
    function isOwnerOrManager(landlordId) {
      let isOwner = request.auth != null && request.auth.uid == landlordId;
      let isManager = request.auth != null && request.auth.token.role == 'manager' && request.auth.token.landlordId == landlordId;
      return isOwner || isManager;
    }

    // Landlords can manage their own profile
    match /landlords/{landlordId} {
      allow read, write: if request.auth != null && request.auth.uid == landlordId;
    }

    // Properties can be accessed by their owner or an authorized manager
    match /properties/{propertyId} {
      allow read: if isOwnerOrManager(resource.data.landlordId);
      allow create: if request.auth != null && request.resource.data.landlordId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.landlordId == request.auth.uid;

      // Units can be accessed by the property owner or an authorized manager
      match /units/{unitId} {
        allow read, write: if isOwnerOrManager(get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId);
      }
    }

    // Tenants can read their own data. Landlords/managers can manage tenants in their properties.
    match /tenants/{tenantId} {
      allow read: if (request.auth != null && request.auth.uid == tenantId) || isOwnerOrManager(resource.data.landlordId);
      allow create: if isOwnerOrManager(request.resource.data.landlordId);
      allow update, delete: if isOwnerOrManager(resource.data.landlordId);
    }
    
    // Managers can be managed by the landlord who owns their profile.
    match /managers/{managerId} {
        allow read, write, delete: if request.auth != null && resource.data.landlordId == request.auth.uid;
    }

    // Payments can be read by the tenant they belong to, or the landlord/manager.
    match /payments/{paymentId} {
        allow read: if (request.auth != null && request.auth.uid == resource.data.tenantId) || isOwnerOrManager(resource.data.landlordId);
        allow create: if isOwnerOrManager(request.resource.data.landlordId);
    }

    // Maintenance requests can be created by a tenant, and managed by the landlord/manager.
    match /maintenanceRequests/{requestId} {
        allow read: if (request.auth != null && request.auth.uid == resource.data.tenantId) || isOwnerOrManager(resource.data.landlordId);
        allow create: if request.auth != null && request.auth.token.role == 'tenant' && request.resource.data.tenantId == request.auth.uid;
        allow update: if isOwnerOrManager(resource.data.landlordId);
    }

    // Messages can be accessed by the tenant or the landlord/manager.
    match /messages/{messageId} {
        allow read, create: if request.auth != null && (request.auth.uid == resource.data.tenantId || isOwnerOrManager(get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)).data.landlordId));
    }
    
    // Audit logs can only be read by the landlord/manager they belong to.
    match /auditLogs/{logId} {
        allow read: if isOwnerOrManager(resource.data.landlordId);
        allow create: if request.auth != null; // Server-side logic handles creation
    }

    // Collection group queries
    match /{path=**}/units/{unitId} {
      allow read: if isOwnerOrManager(resource.data.landlordId);
    }
  }
}
