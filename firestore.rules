
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return request.auth.token.role == "admin";
    }
    
    function isLandlord() {
      return request.auth.token.role == "landlord";
    }
    
    function isTenant() {
      return request.auth.token.role == "tenant";
    }
    
    function isManager() {
      return request.auth.token.role == "manager";
    }

    // Function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Function to check if the user is the owner of the document
    function isOwner(landlordId) {
      return request.auth.uid == landlordId;
    }
    
    // Function to check if a manager is linked to the correct landlord
    function isManagerOf(landlordId) {
      return isManager() && request.auth.token.landlordId == landlordId;
    }

    // Landlords: Can only read/write their own document
    match /landlords/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Managers: Can be read by the landlord who owns them.
    // Write access is handled by server-side logic (invites/updates).
    match /managers/{managerId} {
        allow read: if isSignedIn() && (isLandlord() && resource.data.landlordId == request.auth.uid);
        // Managers can be created via server action (accept invite)
        // and updated/deleted by landlords.
    }

    // Properties Collection
    match /properties/{propertyId} {
      // Landlords or their authorized managers can create properties.
      allow create: if isSignedIn() && (isLandlord() || isManager());
      // Only the owning landlord or their authorized managers can read/update/delete.
      allow read, update, delete: if isSignedIn() && (isOwner(resource.data.landlordId) || isManagerOf(resource.data.landlordId));
      
      // Units Subcollection
      match /units/{unitId} {
        // Inherits parent's ownership context.
        allow read, write: if isSignedIn() && (isOwner(get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId) || isManagerOf(get(/databases/$(database)/documents/properties/$(propertyId)).data.landlordId));
      }
    }
    
    // Tenants Collection
    match /tenants/{tenantId} {
      // Landlords/managers can manage tenants.
      allow create, update, delete: if isSignedIn() && (isLandlord() || isManager());
      // Landlords/managers can read their tenants. Tenants can read their own profile.
      allow read: if isSignedIn() && ((isLandlord() || isManager()) && resource.data.landlordId == request.auth.token.landlordId || isOwner(tenantId));
    }
    
    // Payments Collection
    match /payments/{paymentId} {
      // Tenants can create payments for themselves. Landlords/managers can log payments.
      allow create: if isSignedIn() && (isTenant() || isLandlord() || isManager());
      // Landlords/managers can read payments for their portfolio. Tenants can read their own payments.
      allow read: if isSignedIn() && ((isLandlord() || isManager()) && resource.data.landlordId == request.auth.token.landlordId || isOwner(resource.data.tenantId));
    }
    
    // Messages Collection
    match /messages/{messageId} {
        // Anyone involved in the conversation can read/write.
        allow read, write: if isSignedIn() && (
            (isLandlord() || isManager()) && get(/databases/$(database)/documents/tenants/$(resource.data.tenantId)).data.landlordId == request.auth.token.landlordId ||
            isTenant() && request.auth.uid == resource.data.tenantId
        );
    }
    
    // Maintenance Requests Collection
    match /maintenanceRequests/{requestId} {
        // Tenants can create requests for themselves.
        allow create: if isSignedIn() && isTenant();
        // Landlords/managers can read/update requests for their portfolio. Tenants can read their own requests.
        allow read, update: if isSignedIn() && ((isLandlord() || isManager()) && resource.data.landlordId == request.auth.token.landlordId || isOwner(resource.data.tenantId));
    }

    // Audit Logs and Reminders: Only accessible by the landlord.
    match /auditLogs/{logId} {
      allow read, write: if isSignedIn() && isLandlord() && isOwner(resource.data.landlordId);
    }
    
    match /reminders/{reminderId} {
        allow read, write: if isSignedIn() && (isLandlord() || isManager());
    }
  }
}
